  "item": [
    {
      "name": "01 - First-Time Borrower (12-Month Installment)",
      "description": "A new borrower (0 past loans) applies for a Personal Installment Loan and follows the full lifecycle: apply \u2192 disburse \u2192 view schedule \u2192 make a payment.",
      "item": [
        {
          "name": "1.1 Apply for Loan (12 cycles)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Loan is APPROVED', () => pm.expect(body.status).to.eql('APPROVED'));",
                  "pm.test('Correct product', () => pm.expect(body.productId).to.eql('PERSONAL_INSTALLMENT_LOAN'));",
                  "pm.collectionVariables.set('installmentLoanId', body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"PERSONAL_INSTALLMENT_LOAN\",\n  \"borrowerId\": \"borrower-alice-001\",\n  \"requestedAmount\": 10000,\n  \"currency\": \"USD\",\n  \"pastLoanCount\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/loans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans"
              ]
            }
          }
        },
        {
          "name": "1.2 Get Loan \u2014 Verify APPROVED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Status is APPROVED', () => pm.expect(body.status).to.eql('APPROVED'));",
                  "pm.test('Outstanding principal is zero before disbursal', () => pm.expect(body.outstandingPrincipal).to.eql(0));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/loans/{{installmentLoanId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans",
                "{{installmentLoanId}}"
              ]
            }
          }
        },
        {
          "name": "1.3 Disburse Loan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Loan is ACTIVE', () => pm.expect(body.status).to.eql('ACTIVE'));",
